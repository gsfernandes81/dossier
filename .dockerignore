# Build-context excludes for `docker build` (Dockerfile.dev). The dev image only
# COPYs pyproject.toml + uv.lock + the dev scripts; the source arrives at runtime as a
# clone in the /workspace volume, so this mainly keeps the context small and
# secrets/personal data out of a local build. (infra builds from this repo's git URL,
# whose context is the tracked tree only.)

.git
.claude/
.dev-ssh/
.venv

**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.ropeproject
htmlcov
.coverage
.coverage.*

*.env

# dossier: never pull personal data, local config, or scratch into the build context.
.dossier/
scratch/
*.local.toml
config.local.toml
notion-export*.json

# Syncthing bookkeeping.
.stfolder/
.stignore

docs/
