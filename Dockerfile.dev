# syntax=docker/dockerfile:1

# ds-dev — a THIN CHILD of gsrpi-dev-base. Everything this container shares with the other
# dev containers on zero (infra-dev, or3-dev, dd-dev) lives in infra's `dev/Dockerfile.base`
# and is pulled, not rebuilt: the toolchain, Claude Code, gh, zmx, fish, sshd and its one
# config, the `dev` user, every dotfile, and the entrypoint that starts the lot.
# What is left here is only what makes this image not one of the others — a compiler for
# source builds, and this project's venv with its extras and the `driver` group.
#
# WHO BUILDS THIS, since 2026-10-27: infra. ds-dev is one service in infra's dev Compose
# project (`dev/compose.yaml`, service `ds-dev`), which builds this file straight from this
# repo's `main` on GitHub and passes BASE_TAG from its own `x-base-tag` line. So a change
# here reaches the container only once it is on `main` and infra rebuilds it, and the ARG
# default below is only a fallback for a build outside infra. Its name, volumes, secrets
# directory and environment are that service's, not anything in this repo.
#
# PINNED TAG, never `latest`: a base rebuild must not change this container until infra's
# tag moves. The base is PUBLIC on ghcr, built by infra's `.github/workflows/dev-base.yml`.
#
# THE OFFLINE FALLBACK is `make base` in infra's `dev/`. It builds the identical image
# locally UNDER THE SAME NAME, and docker prefers a local image over a pull — so a GitHub
# outage, a metered month, or a host whose uid is not the one the CI image bakes means
# building it there, and this file is none the wiser.
ARG BASE_TAG=2026.10.26
FROM ghcr.io/gsfernandes81/gsrpi-dev-base:${BASE_TAG}

# Re-declared, because an ARG stated before FROM is out of scope after it. Recorded as a
# label so WHICH BASE THIS CONTAINER IS ON is answerable from a running container —
# `docker inspect ds-dev --format '{{index .Config.Labels "uk.gsrpi.base-tag"}}'` — rather
# than inferred from behaviour, which is the kind of check that passes for a wrong reason.
ARG BASE_TAG
LABEL uk.gsrpi.base-tag="${BASE_TAG}"

# The base ends as the dev user; everything below writes system paths until USER dev.
USER root

# build-essential is the only apt package the base does not carry: it covers the source
# builds Claude Code or the TUI driver need on arm64, where a wheel may not exist. git,
# make, fish, the ssh client and server, curl, gnupg, ca-certificates and tzdata all come
# from the base.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# The dev account's login shell goes back to bash, which the base sets to fish. Not a
# preference: sshd forces every session through the base's dev-door, which runs a forwarded
# command as `$SHELL -c '<cmd>'` and a login as `$SHELL -l`, and sshd takes $SHELL from
# /etc/passwd. So this is the shell under every `ssh dev ssh ds-dev '<cmd>'`, the hub's own
# calls, the menu's `s`, `make shell C=ds-dev` — and Zed's remote bootstrap, should infra
# give a container a route for it again. This repo's tooling assumes POSIX there:
# `x=$(...)` assignments, `if …; then … fi`, heredocs and `$?` are fish syntax errors.
# fish is still installed; type `fish` in that shell.
RUN usermod --shell /bin/bash dev

# TZ, CLAUDE_CONFIG_DIR, GH_CONFIG_DIR, HISTFILE and SCREENDIR are all set in the base and
# are deliberately not repeated here — a value stated twice is a value that drifts. What is
# left is this project's own.
#
# The venv lives OUTSIDE /workspace so the workspace volume cannot shadow it. VIRTUAL_ENV
# mirrors UV_PROJECT_ENVIRONMENT so ty/ruff/Zed toolchain detection find it over SSH (they
# key off VIRTUAL_ENV, and this repo has no project-local .venv).
#
# PATH is set in the image so a `docker exec` and an ssh session answer `python` the same
# way; the base publishes whatever PATH it inherits into ~/.ssh/environment.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/home/dev/venv \
    VIRTUAL_ENV=/home/dev/venv \
    PATH=/home/dev/venv/bin:$PATH

# Pre-build the full dependency set into /home/dev/venv: the dev group (default), all
# extras (dedup + scan), and the opt-in `driver` group for the real-terminal TUI harness
# in tools/. The editable project is added at container start by child-init.sh, once
# /workspace holds the clone. KEEP THESE FLAGS IN SYNC with docker-child-init.dev.sh — a
# start that syncs with fewer flags than the build used would uninstall the baked extras.
#
# RUN AS ROOT AND CHOWNED, because the base owns the account. A BuildKit cache mount is
# created root-owned and takes a NUMERIC uid to be anything else; rather than guess that
# number (the CI base bakes 1001, a `make base` bakes the host owner's), the sync runs as
# root against a root-owned cache and the venv is handed to dev in the same layer.
COPY --chown=dev:dev pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv \
    uv sync --frozen --no-install-project --all-extras --group driver \
    && chown -R dev:dev /home/dev/venv

USER dev

# The volume mountpoints the base does not already create (infra's service mounts
# ds-uv-cache and ds-zed-server here). A volume that is empty on first use inherits the
# ownership of the directory it covers, so a mountpoint created by root is one uv and Zed
# cannot write to.
RUN mkdir -p /home/dev/.cache/uv /home/dev/.zed_server

# ── the seams, which is all a child is meant to need ────────────────────────
#
# ~/.ssh/config's baked half. The base prepends $DEV_SECRETS_DIR/ssh_config.fleet — the
# host's ~/.ds-dev-secrets, mounted read-only at /run/ds-secrets — to it at every start.
# See ssh_config.dev.
COPY --chown=dev:dev ssh_config.dev /home/dev/ssh_config

# NO sshd DROP-IN. Since base 2026-10-27 sshd reads only the base's sshd_config, and a
# `sshd_config.d/` a child copies in is ignored — so there is nothing here to set sshd with.

# The login walkthrough — the hub's token, the identities, Claude, the clone. infra's
# `make login C=ds-dev` runs it.
COPY --chown=dev:dev docker-login.dev.sh /home/dev/login.sh

# What this image does at start that the base cannot know about: the venv.
COPY --chown=dev:dev docker-child-init.dev.sh /home/dev/child-init.sh

# WORKDIR, EXPOSE and CMD are inherited.
