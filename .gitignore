# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# PyInstaller
*.manifest
*.spec

# Test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.cache
.pytest_cache/
.hypothesis/

# Type-checker / linter caches
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# Git worktrees created under the repo (e.g. by the Claude Code harness) — these are
# separate checkouts, not content to commit into the main tree.
.claude/worktrees/

# Dev-container git-identity keys + ssh config (see docker-*.dev.sh). Never commit.
.dev-ssh/

# Environments (uv.lock IS committed — do not ignore it)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.env

# pyenv
.python-version

# Rope
.ropeproject/

# Editors / OS
.idea/
.vscode/settings.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Syncthing
.stfolder/
.stignore
.trash/

# Ad-hoc scratch — not for commit
scratch/

# Local, non-synced data — NEVER commit real documents, the .dossier data folder,
# per-device config, or a real Notion export (they contain personal information).
.dossier/
*.local.toml
config.local.toml
notion-export*.json

# Core dumps
core
core.[0-9]*

# Claude Code sandbox (bubblewrap) phantom mount-points — these don't exist on disk;
# ignored so `git add -A` can't re-stage them as empty blobs.
.bash_profile
.bashrc
.profile
.zshrc
.zprofile
.gitconfig
.gitmodules
.ripgreprc
