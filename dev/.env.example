# Copy to dev/.env on the host that runs the container (`cp .env.example .env`).
# .env is gitignored: it holds absolute host paths, and one of them points at the
# host user's ssh directory.
#
# Compose reads this file for INTERPOLATION. A name in here reaches the container
# only if compose.yaml also names it under `environment:` — GIT_USER_* and
# DS_REMOTE_CONTROL do; the rest shape the stack from outside.
#
# Absolute paths, never $HOME: HOME is unset or root's under sudo and cron, and
# the Makefile runs docker through sudo. A $HOME here works by hand and breaks the
# moment anything automates it. (DS_SRC — the clone itself — is NOT set here: the
# Makefile derives it from its own location, which cannot go stale.)

# ── required ────────────────────────────────────────────────────────────────
# The HOST user's .ssh DIRECTORY, bind-mounted read-only. The in-container sshd
# reads authorized_keys straight out of it, so the keys that reach the host reach
# this container and there is no second list to maintain. Point it at the
# DIRECTORY, not the file, and make sure that directory's authorized_keys lists
# the public key(s) that will connect (your laptop's, Zed's, the phone's).
DEV_SSH_AUTHORIZED_KEYS=/home/<host-user>/.ssh/

# ── the ssh endpoint ────────────────────────────────────────────────────────
# The host-side port mapped to the container's sshd. The container side is always
# 2222. 2222 is dd-dev and 2224 is or3-dev on the same box, so this one is 2225 —
# the number is this container's identity there, so change it only if you have a
# real collision. Point ssh / Zed / a Cloudflare tunnel at whatever you set.
DEV_SSH_PORT=2225

# The ADDRESS that port is published on. Loopback by default, and that default is
# the whole of this port's protection: sshd behind it is key-only, but what a key
# gets you is a shell in a container holding a GitHub push key, a gh token and a
# Claude login. A cloudflared running on the host ITSELF reaches 127.0.0.1:2225
# with nothing changed here.
#
# Widen it to the docker bridge gateway (e.g. 172.17.0.1) only if cloudflared runs
# in a container of its own and so cannot see the host's loopback. Set it to
# 0.0.0.0 only if you deliberately want to ssh in from the home LAN. Publishing is
# create-time: a change lands on `make up`, never on `make restart`.
DEV_SSH_BIND=127.0.0.1

# ── the container ───────────────────────────────────────────────────────────
# The container's hostname, and the machine title Claude Code shows. The Makefile
# defaults it to <host-hostname>-ds-dev; set it here only to override.
# DEV_HOSTNAME=my-ds-dev

# cgroup v2 memory.max / memory.swap.max for this container alone. A cap, not a
# reservation: it confines an OOM kill to this container's own cgroup so a runaway
# build here cannot reap a neighbour on the same Pi. The default is generous on
# purpose — the hungriest thing in here is `cargo test --workspace --release`, and
# the release profile is lto="thin" with codegen-units=1. Lower it only if the box
# actually needs the memory back.
DEV_MEM_LIMIT=3072m
DEV_MEMSWAP_LIMIT=4096m

# Commit identity inside the container. Without these, every commit made in here
# dies on "Please tell me who you are".
GIT_USER_NAME=Gavin Fernandes
GIT_USER_EMAIL=gavinfernandes2012@pm.me

# ── Claude Remote Control ───────────────────────────────────────────────────
# Driving this container from claude.ai/code or the mobile app. OFF by default:
# the way in is `ssh ds-dev` from a PC or Termux, with abduco holding the session.
# A remote-control daemon nobody is driving is a live claude with a permission
# classifier for company. Set to 1 for a spell away from a terminal, then
# `make up` — the entrypoint reads it at start, so `make restart` does not pick it
# up. Its log is `make rc-log`; it never touches sshd or the container's lifetime.
DS_REMOTE_CONTROL=0
