# dossier remote dev container (docker-compose.dev.yml) — the ONLY vars it needs.
# Copy this to `.env` (gitignored) and set DEV_SSH_AUTHORIZED_KEYS. dossier itself
# needs no runtime env vars; this file exists solely for the dev container, and
# docker compose reads `.env` automatically for the interpolation below.

# The HOST user's .ssh directory, bind-mounted read-only into the container so the
# in-container sshd (Zed-remote / direct SSH on port 2222) authorizes the same keys.
# Its authorized_keys must list the pubkey(s) that will connect (e.g. Zed's, your
# laptop's). Point it at the directory, not the file.
DEV_SSH_AUTHORIZED_KEYS=/home/<host-user>/.ssh/

# Host port mapped to the in-container sshd (defaults to 2222). Change it if 2222 is
# taken on the host or you run more than one dev container. The container side stays
# 2222; point Zed / the Cloudflare tunnel / your `ssh` at whatever you set here.
# DEV_SSH_PORT=2222

# Optional: override the container hostname Claude Code shows as the machine title.
# `make dev-up` sets this to <host-hostname>-ds-dev automatically; set it here only
# to override.
# DEV_HOSTNAME=my-ds-dev
